{
  "name": "depression-check",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "deploy:harness": "bash deploy/tests/release-harness.sh",
    "deploy:packet": "node bin/print-deployment-verification-packet.js",
    "phase:status": "node bin/print-phase-status.js",
    "deploy:smoke": "node bin/check-deployed-site.js",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "test": "node --test \"tests/**/*.test.js\"",
    "validate": "node bin/validate-instruments.js",
    "assessment:evaluate": "node bin/evaluate-assessment-cases.js",
    "test:e2e": "playwright test",
    "a11y": "node bin/a11y-audit.js",
    "manual:check": "node bin/validate-manual-verification.js",
    "manual:packet": "node bin/print-manual-verification-packet.js",
    "validation:evidence:check": "node bin/validate-korean-validation-evidence.js",
    "legal:evidence:check": "node bin/validate-legal-review-evidence.js",
    "clinical:handoff:check": "node bin/validate-clinical-handoff-evidence.js",
    "abc:evidence:check": "node bin/validate-abc-expert-review-evidence.js",
    "abc:packet": "node bin/print-abc-review-packet.js",
    "privacy:check": "node bin/privacy-audit.js",
    "storage:check": "node bin/storage-boundary-audit.js",
    "security:check": "node bin/security-header-audit.js",
    "security:build:check": "node bin/security-build-audit.js",
    "pwa:check": "node bin/pwa-audit.js",
    "skill:check": "node bin/check-ouroboros-skill.js",
    "release:ready": "npm run resources:check && npm run privacy:check && npm run storage:check && npm run security:check && npm run security:build:check && npm run pwa:check && node bin/release-readiness.js",
    "resources:check": "node bin/validate-resources.js"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "eas-cli": "^20.0.0"
  }
}
